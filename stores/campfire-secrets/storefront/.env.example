# Stripe TEST MODE keys only. Never put live keys in this file or in code.
# Get test keys at https://dashboard.stripe.com/test/apikeys
# (gear icon → Developers → API keys, with "Test mode" toggled on)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY

# Gemini API key for the Trail Guide chat (server-side only, never exposed
# to the browser). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
